    {
      "id": "12a2f1e6-403d-52c1-994d-ecccd75efdbb",
      "name": "Label ids",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "jsCode": "const WANT = {\"triage\": {\"To respond\": \"To respond\", \"Awaiting reply\": \"Awaiting reply\", \"Meeting update\": \"Meeting update\", \"Comment\": \"Comment\", \"Notification\": \"Notification\", \"FYI\": \"FYI\", \"Actioned\": \"Actioned\", \"Newsletter\": \"Newsletter\", \"Marketing\": \"Marketing\", \"Digest\": \"Digest\"}, \"doubt\": \"🤖 To Check\", \"forceAi\": \"🤖 Force AI\"};   // {triage: {role: label name}, doubt: name, forceAi: name}\nconst byName = new Map($input.all().map(i => [String(i.json.name).toLowerCase(), i.json.id]));\nconst id = (name) => byName.get(name.toLowerCase());\nconst missing = [...Object.values(WANT.triage), WANT.doubt, WANT.forceAi].filter(n => !id(n));\nif (missing.length) throw new Error('Missing Gmail labels: ' + missing.join(', '));\nreturn [{ json: {\n  triage: Object.fromEntries(Object.entries(WANT.triage).map(([role, name]) => [role, id(name)])),\n  doubt: id(WANT.doubt), forceAi: id(WANT.forceAi) } }];"
      }
    },
