    {
      "id": "9de69f4a-71f5-54b3-b71b-bd6f99ed34d5",
      "name": "One per sender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        600
      ],
      "parameters": {
        "jsCode": "const seen = new Set();\nreturn $input.all().map(i => (i.json.from?.value?.[0]?.address || '').trim().toLowerCase())\n  .filter(a => a && !seen.has(a) && seen.add(a))\n  .map(pattern => ({ json: { pattern } }));"
      }
    },
