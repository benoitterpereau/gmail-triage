    {
      "id": "f0014a33-9c28-5205-94ec-27b5de837395",
      "name": "Jev",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.typesafe.ai/v1/systemone",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"jev-1.13.0\", state: { from: $json.fromName ? $json.fromName + ' <' + $json.from + '>' : $json.from, to: $json.to, subject: $json.subject, date: $json.date, has_unsubscribe_link: $json.hasUnsubscribeLink, body: $json.body, ...($json.senderHistory ? { sender_history: $json.senderHistory } : {}) }, questions: {\"category\": {\"type\": \"choice\", \"instructions\": \"Pick the triage label for this email, from the point of view of its recipient. When several labels fit, pick the one that comes first in this priority order: To respond, Meeting update, Comment, Notification, FYI, Actioned, Newsletter, Marketing.\", \"criteria\": {\"To respond\": \"Requires a reply or an action from the recipient: a named person writes directly to the recipient by email (even from a company: personal invitation, follow-up, introduction, request, link to book a meeting slot, startup founder pitching their fundraising, question asked in a LinkedIn or platform conversation the recipient already takes part in), or an automated message requires action (failed payment, invoice or request to validate, document to sign, deadline, account action required). A verification or login code is not an action. Unsolicited sales or paid-study outreach is Marketing, even when written by a named person.\", \"Meeting update\": \"Calendar invitation or change for a meeting the recipient takes part in: invite, acceptance, decline, reschedule, cancellation, or video-call details. Not webinars or events promoted to a mailing list.\", \"Comment\": \"Mention or comment notification from a collaborative tool (Jira, Confluence, Notion, Google Docs, Figma, GitHub...).\", \"Notification\": \"Automated message from a system or service that requires no action: verification or login code, security alert, receipt, paid invoice, shipping, event registration confirmation, account, service or status update, emoji reaction to an email ('X reacted via Gmail'), or social network alert (connection request, new follower, job alert, 'you have a new message'), even when it quotes a personal note from someone, unless that note asks the recipient something in a conversation they already take part in.\", \"FYI\": \"Message written by a person to share information; no reply or action expected.\", \"Actioned\": \"Confirms that a request, booking or conversation is done, settled or acknowledged ('noted', 'done', 'see you later'); nothing left to do.\", \"Newsletter\": \"Editorial or recurring content from a publication or creator the recipient subscribed to (articles, news, curated tips), even when it features products, shops or deals.\", \"Marketing\": \"Mass email from a brand or service promoting its own products, offers, programmes or content (including welcome and onboarding emails after a sign-up), cold sales outreach or paid survey or research solicitation (even written and signed by a named person), or invitation to a webinar, live session or event sent to a mailing list (even signed by the organiser).\"} } } }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
